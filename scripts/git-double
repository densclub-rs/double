#!/usr/bin/env python3
"""Opt-in, local Git exclusions for untracked Markdown drafts."""
import argparse
import contextlib
import io
import os
from pathlib import Path
import re
import subprocess
import sys
import time

BEGIN = '# BEGIN git-double drafts\n'
END = '# END git-double drafts\n'
DEFAULTS = ('.double', 'ideas', 'goals', 'knowledge')


def git(*args, data=None, allowed=(0,)):
    result = subprocess.run(['git', *args], input=data, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE)
    if result.returncode not in allowed:
        raise ValueError(result.stderr.decode(errors='replace').strip())
    return result.stdout


def pattern(path):
    return '/' + ''.join('\\' + c if c in '\\*?[] !#' else c for c in path)


def status(path):
    # Only the document's opening frontmatter, never examples in its body.
    with path.open(encoding='utf-8-sig') as stream:
        if stream.readline().strip() != '---':
            return '-'
        values = []
        for line in stream:
            if line.strip() in ('---', '...'):
                return values[0] if len(values) == 1 else '-'
            match = re.fullmatch(r'''status:[ \t]*(?:"([^"\n]*)"|'([^'\n]*)'|([^#\n]*?))[ \t]*(?:#.*)?\n?''', line)
            if match:
                values.append(next(v for v in match.groups() if v is not None).strip())
    return '-'


def split_exclude(text):
    if BEGIN not in text and END not in text:
        return text, set(), ''
    if text.count(BEGIN) != 1 or text.count(END) != 1:
        raise ValueError('Malformed git-double block in info/exclude; refusing to edit.')
    before, remainder = text.split(BEGIN)
    managed, after = remainder.split(END)
    return before, set(managed.splitlines()), after


def files_in(root, scopes):
    found = set()
    for scope in scopes:
        if scope.is_symlink():
            continue
        if scope.is_file():
            if scope.suffix.lower() == '.md':
                found.add(scope.relative_to(root).as_posix())
            continue
        for directory, dirs, files in os.walk(scope, followlinks=False):
            dirs[:] = [d for d in dirs if d != '.git' and not Path(directory, d).is_symlink()]
            for name in files:
                path = Path(directory, name)
                if path.suffix.lower() == '.md' and not path.is_symlink():
                    found.add(path.relative_to(root).as_posix())
    if any('\n' in p or '\r' in p for p in found):
        raise ValueError('Markdown filenames containing newlines are not supported.')
    return sorted(found)


def run(root, scopes, exclude, sync):
    paths = files_in(root, scopes)
    tracked = set(os.fsdecode(git('ls-files', '-z')).split('\0'))
    original = exclude.read_text() if exclude.exists() else ''
    before, managed, after = split_exclude(original)
    updated = set(managed)
    states = {p: status(root / p) for p in paths}
    for path in paths:
        entry = pattern(path)
        if path not in tracked and states[path] == 'draft':
            updated.add(entry)
        else:
            updated.discard(entry)
    # Prune stale entries for deleted/renamed files only in the requested scope.
    for entry in managed:
        decoded = re.sub(r'\\(.)', r'\1', entry[1:])
        candidate = root / decoded
        if entry.startswith('/') and any(candidate == s or s in candidate.parents for s in scopes):
            if not candidate.is_file() or decoded in tracked:
                updated.discard(entry)
    if sync and updated != managed:
        prefix = before + ('\n' if before and not before.endswith('\n') else '')
        content = prefix + BEGIN + ''.join(p + '\n' for p in sorted(updated)) + END + after
        exclude.parent.mkdir(parents=True, exist_ok=True)
        lock = exclude.with_name(exclude.name + '.lock')
        # Fail rather than overwrite another writer's changes.
        with lock.open('x') as stream:
            try:
                if (exclude.read_text() if exclude.exists() else '') != original:
                    raise ValueError('info/exclude changed concurrently; retry sync.')
                stream.write(content)
                stream.flush()
                if exclude.exists():
                    os.chmod(lock, exclude.stat().st_mode & 0o777)
                os.replace(lock, exclude)
            finally:
                lock.unlink(missing_ok=True)
        print(f'Synced: +{len(updated - managed)} / -{len(managed - updated)} local exclusions')
    candidates = [p for p in paths if p not in tracked]
    ignored = set()
    if candidates:
        ignored = set(os.fsdecode(git('check-ignore', '-z', '--stdin',
                       data=os.fsencode('\0'.join(candidates) + '\0'), allowed=(0, 1))).split('\0'))
    mismatches = 0
    for path in paths:
        state = states[path]
        if path in tracked:
            result = 'TRACKED (exempt)'
        elif state not in ('draft', 'release-candidate', 'stable'):
            result = 'UNMANAGED'
        else:
            hidden = path in ignored
            ok = hidden == (state == 'draft')
            mismatches += not ok
            result = ('OK' if ok else 'MISMATCH') + (' ignored' if hidden else ' visible')
        print(f'{result}\t{state}\t{path}')
    print(f'{len(paths)} documents; {mismatches} mismatches')
    return int(bool(mismatches))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('check', 'sync', 'watch'))
    parser.add_argument('paths', nargs='*', help='Files/directories relative to current directory; default: repository document roots')
    parser.add_argument('--interval', type=float, default=2, help='Watch polling interval in seconds (default: 2)')
    args = parser.parse_args()
    if not 0 < args.interval < float('inf'):
        parser.error('--interval must be a finite positive number')
    root = Path(os.fsdecode(git('rev-parse', '--show-toplevel')).strip()).resolve()
    scopes = [Path(p).absolute() for p in args.paths] if args.paths else [root / p for p in DEFAULTS]
    for scope in scopes:
        if args.paths and not scope.exists():
            raise ValueError(f'Path does not exist: {scope}')
        if not scope.resolve().is_relative_to(root):
            raise ValueError(f'Path is outside repository: {scope}')
        if '.git' in scope.relative_to(root).parts:
            raise ValueError('The .git directory cannot be scanned.')
    scopes = [s.resolve() for s in scopes]
    os.chdir(root)
    exclude = Path(os.fsdecode(git('rev-parse', '--git-path', 'info/exclude')).strip()).absolute()
    if args.command != 'watch':
        return run(root, scopes, exclude, args.command == 'sync')
    print('Watching; Ctrl-C to stop. No commits, staging changes, or hooks.', flush=True)
    previous = None
    while True:
        output = io.StringIO()
        with contextlib.redirect_stdout(output):
            run(root, scopes, exclude, True)
        report = output.getvalue()
        # Report transitions, without repeating an unchanged inventory every poll.
        comparison = '\n'.join(line for line in report.splitlines() if not line.startswith('Synced:'))
        if comparison != previous or report.startswith('Synced:'):
            print(report, end='', flush=True)
        previous = comparison
        time.sleep(args.interval)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
    except (OSError, ValueError, UnicodeError) as error:
        print(f'git-double: {error}', file=sys.stderr)
        sys.exit(2)
